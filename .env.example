# APP ID
NEXT_PUBLIC_APP_ID=
# APP API key
NEXT_PUBLIC_APP_KEY=
# API url prefix
NEXT_PUBLIC_API_URL=

# Auth.js / NextAuth (SSO)
AUTH_SECRET=
# The public base URL of this app, e.g. http://localhost:3000 in development
AUTH_URL=
# OIDC issuer, defaults to https://sso-id.com locally and https://sso.thape.com.cn in production
AUTH_SSO_ISSUER=https://sso-id.com
AUTH_SSO_CLIENT_ID=
AUTH_SSO_CLIENT_SECRET=
